{
  "name": "job-hunter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Send LinkedIn posts to a Google Sheet with one click; ChatGPT writes the application email; Gmail draft with the right CV.",
  "scripts": {
    "login": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx src/login.ts",
    "process": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx src/process.ts",
    "test": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --import tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
